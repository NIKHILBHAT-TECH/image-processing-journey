        h, s, v = hsv_frame[y, x]
        print(f"Clicked at ({x},{y}) -> HSV: (H={h}, S={s}, V={v})")
        points.append((x, y))
        print("Point captured:", (x, y))
        print(points)
                       # note: index as [row, col] = [y, x]
        print(f"Clicked at ({x}, {y}) ->HSV: (H={h}, S={s}, V={v})")

cv2.namedWindow("HSV")
